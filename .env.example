# --- required: who gets in ---
PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
# openssl rand -base64 48  (rotating this signs everyone out)
SESSION_SECRET=
SESSION_HOURS=12

# --- site content (replaces /balls) ---
MAIN_API_URL=http://localhost:5000
MAIN_ADMIN_TOKEN=

# --- CDN files ---
CDN_WEBDAV_URL=https://cdn.deltavdevs.com/webdav/
CDN_WEBDAV_USER=
CDN_WEBDAV_PASSWORD=
CDN_PUBLIC_URL=https://cdn.deltavdevs.com

# --- DeltaTime fraud review ---
DELTATIME_URL=https://deltatime-production.up.railway.app
DELTATIME_ADMIN_KEY=
# optional: name of the TELESCREEN_PG_* connection that is DeltaTime's DB (default "deltatime")
DELTATIME_PG_CONNECTION=deltatime

# --- Ward accounts (WARD_ADMIN_KEY must match the one set on Ward) ---
WARD_URL=https://ward.deltavdevs.com
WARD_ADMIN_KEY=

# --- data connections: any number, discovered by prefix ---
TELESCREEN_PG_MAIN=postgres://...
TELESCREEN_PG_DELTATIME=postgres://...
TELESCREEN_REDIS_MAIN=redis://...
TELESCREEN_HTTP_BACKEND=https://.../health

# --- Railway (project token = one environment of one project) ---
RAILWAY_PROJECT_TOKEN=
# or an account token plus explicit ids:
# RAILWAY_API_TOKEN=
# TELESCREEN_RAILWAY_PROJECT_ID=
# TELESCREEN_RAILWAY_ENVIRONMENT_ID=
